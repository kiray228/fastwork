<?xml version="1.0" encoding="utf-8"?>
<!--
  Android с 9-й версии запрещает обычный http:// — только https://.
  Это правильно: по http данные идут открытым текстом, и прочитать их
  может любой в той же сети.

  Но пока сервер запущен у тебя на компьютере, https у него нет —
  сертификат для домашнего адреса взять неоткуда. Поэтому здесь
  http разрешён.

  ВАЖНО: это послабление для учёбы. Перед настоящей публикацией
  приложения строку cleartextTrafficPermitted надо убрать и ходить
  только на https-адрес сервера в интернете.

  Точечно разрешить только домашнюю сеть, к сожалению, нельзя:
  Android сверяет имена целиком и не понимает диапазоны адресов.
  Либо конкретный адрес, либо все — поэтому и приходится выбирать
  между удобством и строгостью осознанно.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true"/>
</network-security-config>
